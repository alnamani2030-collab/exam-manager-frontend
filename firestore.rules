rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ✅ قائمة إيميلات مالك المنصة.
    // أضف الإيميل الثاني مكان SECOND_OWNER_EMAIL_HERE إذا أردت الاعتماد على القواعد مباشرة.
    // يمكن أيضًا إضافة الإيميل الثاني في allowlist بدور super_admin و enabled=true.
    function ownerEmails() {
      return ["moe123@gmail.com", "yousef.namani@moe.om"];
    }

    function signedIn() { return request.auth != null; }
    function authEmail() { return signedIn() ? request.auth.token.email : ""; }

    function ownerAllowRef() {
      return /databases/$(database)/documents/allowlist/$(authEmail());
    }

    function isAllowlistOwner() {
      return signedIn()
        && exists(ownerAllowRef())
        && get(ownerAllowRef()).data.enabled == true
        && (
          get(ownerAllowRef()).data.role == "super_admin" ||
          get(ownerAllowRef()).data.role == "owner" ||
          get(ownerAllowRef()).data.role == "platform_owner"
        );
    }

    function isOwner() {
      return signedIn() && (authEmail() in ownerEmails() || isAllowlistOwner());
    }

    // ✅ يمنع المستخدم العادي من تعديل حقول الصلاحيات داخل ملفه الشخصي.
    // مصدر الصلاحيات الحقيقي يبقى allowlist فقط.
    function hasNoSensitiveUserProfileFields(data) {
      return !data.keys().hasAny([
        "role",
        "roles",
        "tenantId",
        "effectiveTenantId",
        "allowedTenants",
        "governorate",
        "tenantGovernorate",
        "regionAr",
        "readOnly",
        "permissions",
        "isOwner",
        "owner",
        "enabled",
        "disabled"
      ]);
    }

    function isSameUserSafeProfileWrite(userId) {
      return signedIn()
        && request.auth.uid == userId
        && hasNoSensitiveUserProfileFields(request.resource.data);
    }

    function allowRef() {
      return /databases/$(database)/documents/allowlist/$(authEmail());
    }

    function allowDocExists() {
      return signedIn() && exists(allowRef());
    }

    function allowData() {
      return get(allowRef()).data;
    }

    function allowEnabled() {
      return allowDocExists() && allowData().enabled == true;
    }

    function allowRole() {
      return allowDocExists() ? allowData().role : "";
    }

    function allowTenantId() {
      return allowDocExists() ? allowData().tenantId : "";
    }

    // قراءة المحافظة من أكثر من اسم حقل حتى لا تفشل الصلاحيات
    // إذا كانت البيانات محفوظة باسم tenantGovernorate أو regionAr بدل governorate.
    function recordGovernorate(data) {
      return data.get("governorate",
        data.get("tenantGovernorate",
          data.get("regionAr",
            data.get("governorateAr",
              data.get("scopeGovernorate",
                data.get("gov", "")
              )
            )
          )
        )
      );
    }

    function allowGovernorate() {
      return allowDocExists() ? recordGovernorate(allowData()) : "";
    }

    function isMinistrySuperRole() {
      return allowEnabled() && allowRole() == "ministry_super";
    }

    function isRegionalSuperRole() {
      return allowEnabled() && (
        allowRole() == "super" ||
        allowRole() == "super_regional" ||
        allowRole() == "regional_super" ||
        allowRole() == "governorate_super" ||
        allowRole() == "governorate-super" ||
        allowRole() == "سوبر المحافظة" ||
        allowRole() == "مشرف المحافظة"
      );
    }

    function isTenantAdmin(tenantId) {
      return allowEnabled()
        && isSchoolAdminRoleValue(allowRole())
        && allowTenantId() == tenantId;
    }

    function isExamSuper(tenantId) {
      return allowEnabled()
        && allowRole() == "exam_super"
        && allowTenantId() == tenantId;
    }

    function isExamCenterRoleValue(role) {
      return role == "exam_super"
        || role == "exam_center_admin"
        || role == "diploma_center_admin"
        || role == "diploma_super"
        || role == "center_admin"
        || role == "center_super"
        || role == "exam_center_super"
        || role == "exam-center-super"
        || role == "exam-center-admin"
        || role == "diploma-center-admin"
        || role == "center-admin"
        || role == "center-super"
        || role == "control_admin"
        || role == "control_super"
        || role == "controller"
        || role == "distribution_super"
        || role == "distribution_admin"
        || role == "رئيس مركز"
        || role == "رئيس مركز دبلوم"
        || role == "مسؤول مركز"
        || role == "مسؤول مركز امتحانات"
        || role == "مسؤول الكنترول"
        || role == "مشرف توزيع"
        || role == "سوبر الامتحانات"
        || role == "رئيس/مسؤول مركز دبلوم";
    }

    function isExamCenterUser(tenantId) {
      return allowEnabled()
        && isExamCenterRoleValue(allowRole())
        && allowTenantId() == tenantId;
    }

    function isTenantUser(tenantId) {
      return allowEnabled()
        && (allowRole() == "user")
        && allowTenantId() == tenantId;
    }

    function tenantRef(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId);
    }

    function tenantConfigRef(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/meta/config;
    }

    function tenantGovernorate(tenantId) {
      return exists(tenantRef(tenantId))
        ? recordGovernorate(get(tenantRef(tenantId)).data)
        : exists(tenantConfigRef(tenantId))
          ? recordGovernorate(get(tenantConfigRef(tenantId)).data)
          : "";
    }

    function sameGovernorateTenant(tenantId) {
      return isRegionalSuperRole()
        && allowGovernorate() != ""
        && tenantGovernorate(tenantId) == allowGovernorate();
    }

    function sameGovernorateInRequest() {
      return isRegionalSuperRole()
        && allowGovernorate() != ""
        && recordGovernorate(request.resource.data) == allowGovernorate();
    }

    function sameGovernorateInUpdatedTenant(tenantId) {
      return isRegionalSuperRole()
        && allowGovernorate() != ""
        && (
          sameGovernorateTenant(tenantId)
          || recordGovernorate(request.resource.data) == allowGovernorate()
        );
    }

    function isSchoolAdminRoleValue(role) {
      return role == "tenant_admin"
        || role == "admin"
        || role == "school_admin"
        || role == "school-admin"
        || role == "admin_school"
        || role == "school-admin-user"
        || role == "schoolAdmin"
        || role == "tenant-admin"
        || role == "مدير المدرسة"
        || role == "مديرة المدرسة"
        || role == "أدمن المدرسة"
        || role == "ادمن المدرسة"
        || role == "مسؤول المدرسة"
        || role == "مسؤولة المدرسة"
        || role == "مشرف المدرسة";
    }

    function canReadTenantRoot(tenantId) {
      return isOwner()
        || isMinistrySuperRole()
        || sameGovernorateTenant(tenantId)
        || isTenantAdmin(tenantId)
        || isExamCenterUser(tenantId)
        || isTenantUser(tenantId);
    }

    function canManageTenantRoot(tenantId) {
      return isOwner() || sameGovernorateTenant(tenantId);
    }

    function canReadTenantInternal(tenantId) {
      return isOwner()
        || isMinistrySuperRole()
        || sameGovernorateTenant(tenantId)
        || isTenantAdmin(tenantId)
        || isExamCenterUser(tenantId)
        || isTenantUser(tenantId);
    }

    function canManageTenantInternal(tenantId) {
      return isOwner() || isTenantAdmin(tenantId) || isExamCenterUser(tenantId);
    }


    // ✅ Phase 5 — Backup / Restore hardening helpers
    // النسخة السحابية يجب أن تكون مرتبطة بنفس الـ tenant ولا يسمح بتزوير tenantId داخلها.
    function backupTenantField(data) {
      return data.get("tenantId", data.get("meta", {}).get("tenantId", ""));
    }

    function backupIdField(data) {
      return data.get("backupId", "");
    }

    function backupTenantMatchesRequest(tenantId) {
      return backupTenantField(request.resource.data) == tenantId;
    }

    function backupTenantMatchesExisting(tenantId) {
      return backupTenantField(resource.data) == tenantId;
    }

    function backupIdIsSafe(backupId) {
      return backupIdField(request.resource.data) == "" || backupIdField(request.resource.data) == backupId;
    }

    function backupSchemaIsAllowed() {
      return request.resource.data.get("backupType", "") == ""
        || request.resource.data.backupType == "full-program";
    }

    function backupCreatedAtIsPresent() {
      return request.resource.data.get("createdAtISO", request.resource.data.get("meta", {}).get("createdAtISO", "")) is string
        && request.resource.data.get("createdAtISO", request.resource.data.get("meta", {}).get("createdAtISO", "")) != "";
    }

    function isAllowedBackupCollectionName(name) {
      return name == "__meta__"
        || name == "teachers"
        || name == "exams"
        || name == "rooms"
        || name == "roomBlocks"
        || name == "examRoomAssignments"
        || name == "studentSeatRegister12"
        || name == "schoolControlMembers"
        || name == "schoolControlReports"
        || name == "candidateViolationReports12"
        || name == "candidateWrittenWarnings12"
        || name == "unavailability"
        || name == "archive"
        || name == "cloudLocalStorage"
        || name == "settings";
    }

    function isValidBackupDocCreate(tenantId, backupId) {
      return canManageTenantInternal(tenantId)
        && backupTenantMatchesRequest(tenantId)
        && backupIdIsSafe(backupId)
        && backupSchemaIsAllowed()
        && backupCreatedAtIsPresent();
    }

    // يسمح فقط بتحديث حقول سياسة الاحتفاظ، ولا يسمح بتعديل محتوى النسخة بعد إنشائها.
    function isRetentionOnlyBackupUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "retentionPolicyVersion",
        "retentionRole",
        "retentionAnchorISO",
        "retentionDemotedAtISO",
        "retentionExpiresAtISO",
        "retentionUpdatedAtISO",
        "retentionLabelAr",
        "retentionLabelEn"
      ]);
    }

    function isValidBackupRetentionUpdate(tenantId) {
      return canManageTenantInternal(tenantId)
        && backupTenantMatchesExisting(tenantId)
        && backupTenantMatchesRequest(tenantId)
        && isRetentionOnlyBackupUpdate()
        && (
          request.resource.data.retentionRole == "latest"
          || request.resource.data.retentionRole == "standard"
        )
        && request.resource.data.retentionExpiresAtISO is string
        && request.resource.data.retentionExpiresAtISO != "";
    }

    function isValidBackupChunkCreate(tenantId, backupId) {
      return canManageTenantInternal(tenantId)
        && request.resource.data.tenantId == tenantId
        && request.resource.data.backupId == backupId
        && request.resource.data.collectionName is string
        && isAllowedBackupCollectionName(request.resource.data.collectionName)
        && request.resource.data.index is int
        && request.resource.data.index > 0
        && request.resource.data.storageKind is string
        && (
          request.resource.data.storageKind == "rows"
          || request.resource.data.storageKind == "rowPart"
        )
        && request.resource.data.payloadBytes is int
        && request.resource.data.payloadBytes >= 0
        && request.resource.data.payloadBytes <= 900000;
    }

    match /allowlist/{email} {
      // كل مستخدم مصرح له يجب أن يستطيع قراءة مستند صلاحياته فقط بعد تسجيل الدخول.
      // بدون هذا الشرط قد يظهر الحساب مفعلاً في صفحة الدخول من الكاش، ثم تفشل ProtectedRoute في فتح /super-system.
      allow get: if signedIn() && email == authEmail();

      allow get, list, create, update, delete: if isOwner();

      allow get, list: if isMinistrySuperRole();

      // مشرف المحافظة يحتاج قراءة حسابات محافظته داخل صفحة فحص الصلاحيات.
      // يجب أن يكون الاستعلام مقيدًا بالمحافظة نفسها.
      allow get, list: if isRegionalSuperRole()
        && allowGovernorate() != ""
        && recordGovernorate(resource.data) == allowGovernorate();

      allow create: if isRegionalSuperRole()
        && (
          isSchoolAdminRoleValue(request.resource.data.role)
          || isExamCenterRoleValue(request.resource.data.role)
        )
        && recordGovernorate(request.resource.data) == allowGovernorate()
        && request.resource.data.tenantId is string
        && request.resource.data.tenantId != ""
        && tenantGovernorate(request.resource.data.tenantId) == allowGovernorate();

      allow update: if isRegionalSuperRole()
        && allowGovernorate() != ""
        && (
          isSchoolAdminRoleValue(request.resource.data.role)
          || isExamCenterRoleValue(request.resource.data.role)
        )
        && (
          isSchoolAdminRoleValue(resource.data.role)
          || isExamCenterRoleValue(resource.data.role)
        )
        && recordGovernorate(resource.data) == allowGovernorate()
        && resource.data.tenantId is string
        && resource.data.tenantId != ""
        && tenantGovernorate(resource.data.tenantId) == allowGovernorate()
        && recordGovernorate(request.resource.data) == allowGovernorate()
        && request.resource.data.tenantId is string
        && request.resource.data.tenantId != ""
        && tenantGovernorate(request.resource.data.tenantId) == allowGovernorate();

      allow delete: if isRegionalSuperRole()
        && (
          isSchoolAdminRoleValue(resource.data.role)
          || isExamCenterRoleValue(resource.data.role)
        )
        && recordGovernorate(resource.data) == allowGovernorate();

      allow get: if signedIn() && authEmail() == email;
      allow list: if signedIn() && resource.data.email == authEmail();
    }

    match /users/{userId} {
      allow get: if isOwner() || (signedIn() && request.auth.uid == userId);
      allow list: if isOwner();

      // ✅ المستخدم يستطيع إنشاء/تحديث بياناته العامة فقط، وليس حقول الصلاحيات.
      allow create, update: if isOwner() || isSameUserSafeProfileWrite(userId);

      // ✅ حذف حسابات المستخدمين من قاعدة البيانات فقط للمالك.
      allow delete: if isOwner();
    }

    match /systemSuggestions/{docId} {
      allow get, list: if isOwner() || isMinistrySuperRole() || isRegionalSuperRole();

      allow create: if allowEnabled()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.schoolName is string
        && request.resource.data.schoolName.size() > 0
        && request.resource.data.schoolEmail is string
        && request.resource.data.schoolEmail.size() > 0
        && request.resource.data.notes is string
        && request.resource.data.notes.size() > 0
        && request.resource.data.status == "new";

      allow update, delete: if isOwner() || isMinistrySuperRole() || isRegionalSuperRole();
    }

    match /archiveTenants/{tenantId} {
      allow get, list: if isOwner() || isMinistrySuperRole() || sameGovernorateTenant(tenantId);
      allow create, update: if isOwner() || sameGovernorateTenant(tenantId);
      allow delete: if isOwner();
    }

    match /tenantAdminLinks/{tenantId} {
      allow get: if isOwner() || isMinistrySuperRole() || sameGovernorateTenant(tenantId);
      allow list: if isOwner()
        || isMinistrySuperRole()
        || (
          isRegionalSuperRole()
          && allowGovernorate() != ""
          && recordGovernorate(resource.data) == allowGovernorate()
        );

      allow create, update: if (
          isOwner()
          || sameGovernorateTenant(tenantId)
          || (
            isRegionalSuperRole()
            && allowGovernorate() != ""
            && recordGovernorate(request.resource.data) == allowGovernorate()
            && tenantGovernorate(tenantId) == allowGovernorate()
          )
        )
        && request.resource.data.tenantId == tenantId
        && request.resource.data.email is string
        && request.resource.data.email != ""
        && (
          request.resource.data.schoolName is string
          || request.resource.data.tenantName is string
          || request.resource.data.centerName is string
        );

      allow delete: if isOwner() || sameGovernorateTenant(tenantId);
    }



    match /governorateExamSupers/{docId} {
      allow get, list: if isOwner()
        || isMinistrySuperRole()
        || (
          isRegionalSuperRole()
          && allowGovernorate() != ""
          && recordGovernorate(resource.data) == allowGovernorate()
        );

      allow create: if isOwner()
        || (
          isRegionalSuperRole()
          && allowGovernorate() != ""
          && request.resource.data.role == "exam_super"
          && recordGovernorate(request.resource.data) == allowGovernorate()
          && request.resource.data.tenantId is string
          && request.resource.data.tenantId != ""
          && tenantGovernorate(request.resource.data.tenantId) == allowGovernorate()
        );

      allow update: if isOwner()
        || (
          isRegionalSuperRole()
          && allowGovernorate() != ""
          && recordGovernorate(resource.data) == allowGovernorate()
          && request.resource.data.role == "exam_super"
          && recordGovernorate(request.resource.data) == allowGovernorate()
          && request.resource.data.tenantId is string
          && request.resource.data.tenantId != ""
          && tenantGovernorate(request.resource.data.tenantId) == allowGovernorate()
        );

      allow delete: if isOwner()
        || (
          isRegionalSuperRole()
          && allowGovernorate() != ""
          && recordGovernorate(resource.data) == allowGovernorate()
        );
    }

    match /tenants/{tenantId} {
      allow get: if canReadTenantRoot(tenantId);
      allow list: if isOwner()
        || isMinistrySuperRole()
        || (
          isRegionalSuperRole()
          && allowGovernorate() != ""
          && recordGovernorate(resource.data) == allowGovernorate()
        );
      allow create: if isOwner() || sameGovernorateInRequest();
      allow update: if isOwner() || sameGovernorateInUpdatedTenant(tenantId);
      allow delete: if canManageTenantRoot(tenantId);

      match /meta/config {
        // ✅ بيانات الطابع الرسمي لا تُقرأ إلا لمن له صلاحية على نفس الـ tenant.
        // هذا يمنع أي مستخدم مسجل من قراءة إعدادات مدرسة/مركز آخر.
        allow get: if canReadTenantInternal(tenantId);
        allow list: if false;

        allow create: if isOwner()
          || sameGovernorateTenant(tenantId)
          || isTenantAdmin(tenantId)
          || isExamCenterUser(tenantId)
          || (
            isRegionalSuperRole()
            && allowGovernorate() != ""
            && recordGovernorate(request.resource.data) == allowGovernorate()
          );

        allow update: if isOwner()
          || sameGovernorateTenant(tenantId)
          || (
            isRegionalSuperRole()
            && allowGovernorate() != ""
            && recordGovernorate(request.resource.data) == allowGovernorate()
          )
          || isTenantAdmin(tenantId)
          || isExamCenterUser(tenantId);

        allow delete: if isOwner()
          || sameGovernorateTenant(tenantId)
          || isTenantAdmin(tenantId)
          || isExamCenterUser(tenantId);
      }

      match /settings/{docId} {
        allow get, list: if canReadTenantInternal(tenantId);
        allow create, update, delete: if canManageTenantInternal(tenantId);
      }

      match /cloudLocalStorage/{docId} {
        allow get, list: if canReadTenantInternal(tenantId);
        allow create, update, delete: if canManageTenantInternal(tenantId);
      }

      match /teachers/{docId} {
        allow get, list: if canReadTenantInternal(tenantId);
        allow create, update, delete: if canManageTenantInternal(tenantId);
      }

      match /exams/{docId} {
        allow get, list: if canReadTenantInternal(tenantId);
        allow create, update, delete: if canManageTenantInternal(tenantId);
      }

      match /rooms/{docId} {
        allow get, list: if canReadTenantInternal(tenantId);
        allow create, update, delete: if canManageTenantInternal(tenantId);
      }

      match /roomBlocks/{docId} {
        allow get, list: if canReadTenantInternal(tenantId);
        allow create, update, delete: if canManageTenantInternal(tenantId);
      }

      match /examRoomAssignments/{docId} {
        allow get, list: if canReadTenantInternal(tenantId);
        allow create, update, delete: if canManageTenantInternal(tenantId);
      }

      match /studentSeatRegister12/{docId} {
        allow get, list: if canReadTenantInternal(tenantId);
        allow create, update, delete: if canManageTenantInternal(tenantId);
      }

      match /schoolControlMembers/{docId} {
        allow get, list: if canReadTenantInternal(tenantId);
        allow create, update, delete: if canManageTenantInternal(tenantId);
      }

      match /schoolControlReports/{docId} {
        allow get, list: if canReadTenantInternal(tenantId);
        allow create, update, delete: if canManageTenantInternal(tenantId);
      }

      match /candidateViolationReports12/{docId} {
        allow get, list: if canReadTenantInternal(tenantId);
        allow create, update, delete: if canManageTenantInternal(tenantId);
      }

      match /candidateWrittenWarnings12/{docId} {
        allow get, list: if canReadTenantInternal(tenantId);
        allow create, update, delete: if canManageTenantInternal(tenantId);
      }

      match /unavailability/{docId} {
        allow get, list: if canReadTenantInternal(tenantId);
        allow create, update, delete: if canManageTenantInternal(tenantId);
      }

      match /archive/{archiveId} {
        allow get, list: if canReadTenantInternal(tenantId);
        allow create, update, delete: if canManageTenantInternal(tenantId);
      }

      match /realtime/{docId} {
        allow get: if canReadTenantInternal(tenantId);
        allow list: if false;
        allow create, update, delete: if canManageTenantInternal(tenantId);
      }

      match /logs/{logId} {
        allow create: if canManageTenantInternal(tenantId);
        allow get, list: if canManageTenantInternal(tenantId) || isOwner();
        allow update, delete: if false;
      }

      match /backups/{backupId} {
        allow get, list: if canReadTenantInternal(tenantId);

        // ✅ إنشاء النسخة مسموح فقط إذا كان tenantId داخل الوثيقة يطابق مسار الـ tenant.
        allow create: if isValidBackupDocCreate(tenantId, backupId);

        // ✅ تحديث محدود جدًا: حقول سياسة الاحتفاظ فقط، ولا يسمح بتعديل محتوى النسخة.
        allow update: if isValidBackupRetentionUpdate(tenantId);

        allow delete: if canManageTenantInternal(tenantId) && backupTenantMatchesExisting(tenantId);
      }

      // ✅ أجزاء النسخ السحابية: لا نسمح بالتعديل الجزئي بعد الإنشاء.
      // ويمكن إنشاءها فقط للمجموعات المصرح استعادتها.
      match /backups/{backupId}/chunks/{chunkId} {
        allow get, list: if canReadTenantInternal(tenantId);
        allow create: if isValidBackupChunkCreate(tenantId, backupId);
        allow delete: if canManageTenantInternal(tenantId);
        allow update: if false;
      }

      // حماية عامة لأي مجموعات داخلية جديدة يتم إضافتها لاحقًا داخل tenant.
      // القراءة حسب نفس نطاق الـ tenant، والكتابة فقط لمن يملك إدارة هذا الـ tenant.
      match /{tenantDocument=**} {
        allow get, list: if canReadTenantInternal(tenantId);
        allow create, update, delete: if canManageTenantInternal(tenantId);
      }
    }


    // سجل العمليات السحابي المركزي.
    // يكتب كل مستخدم مفعل عملياته، ويرى مالك المنصة السجل الكامل.
    // مشرف المحافظة يرى فقط العمليات المرتبطة بمحافظته إذا كان الاستعلام مقيدًا بنفس المحافظة.
    match /systemAuditLogs/{logId} {
      allow create: if allowEnabled()
        && request.resource.data.at is string
        && request.resource.data.level is string
        && request.resource.data.action is string
        && request.resource.data.label is string
        && (
          !request.resource.data.keys().hasAny(["userEmail"])
          || request.resource.data.userEmail == authEmail()
        );

      allow get, list: if isOwner()
        || isMinistrySuperRole()
        || (
          isRegionalSuperRole()
          && allowGovernorate() != ""
          && recordGovernorate(resource.data) == allowGovernorate()
        )
        || (
          allowEnabled()
          && resource.data.userEmail == authEmail()
        );

      allow update: if false;
      allow delete: if isOwner();
    }



    // سجل الأخطاء السحابي المركزي.
    // يكتب كل مستخدم مفعل أخطاء واجهته، ويرى مالك المنصة السجل الكامل.
    match /systemErrorLogs/{logId} {
      allow create: if allowEnabled()
        && request.resource.data.at is string
        && request.resource.data.level is string
        && request.resource.data.message is string
        && (
          !request.resource.data.keys().hasAny(["userEmail"])
          || request.resource.data.userEmail == authEmail()
        );

      allow get, list: if isOwner()
        || isMinistrySuperRole()
        || (
          isRegionalSuperRole()
          && allowGovernorate() != ""
          && recordGovernorate(resource.data) == allowGovernorate()
        )
        || (
          allowEnabled()
          && resource.data.userEmail == authEmail()
        );

      allow update: if false;
      allow delete: if isOwner();
    }
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
